{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zonal value recipe (one schedule row)",
  "type": "object",
  "required": ["rule_id", "lgu_psgc", "rdo", "barangay", "source", "interpretation", "recipe", "assumptions", "confidence", "status"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "lgu_psgc": {"type": "string", "pattern": "^PH[0-9]{7}$"},
    "rdo": {"type": "string", "minLength": 1},
    "barangay": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["file_sha256", "department_order", "sheet", "row", "text"],
      "properties": {
        "file_sha256": {"type": "string", "minLength": 8},
        "department_order": {"type": "string", "minLength": 1},
        "sheet": {"type": "string", "minLength": 1},
        "row": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "interpretation": {"type": "string", "minLength": 1},
    "recipe": {"type": ["array", "null"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["pending_review", "approved", "rejected", "manual_geometry", "out_of_scope"]}
  }
}
